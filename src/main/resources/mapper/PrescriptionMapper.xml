<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.medical.mapper.PrescriptionMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.example.medical.entity.Prescription">
        <id column="id" property="id" />
        <result column="prescription_no" property="prescriptionNo" />
        <result column="registration_id" property="registrationId" />
        <result column="diagnosis" property="diagnosis" />
        <result column="issued_at" property="issuedAt" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id, prescription_no, registration_id, diagnosis, issued_at
    </sql>

</mapper>
