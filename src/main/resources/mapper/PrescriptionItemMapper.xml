<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.medical.mapper.PrescriptionItemMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.example.medical.entity.PrescriptionItem">
        <id column="id" property="id" />
        <result column="prescription_id" property="prescriptionId" />
        <result column="line_no" property="lineNo" />
        <result column="medicine_id" property="medicineId" />
        <result column="dosage" property="dosage" />
        <result column="frequency" property="frequency" />
        <result column="days" property="days" />
        <result column="quantity" property="quantity" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id, prescription_id, line_no, medicine_id, dosage, frequency, days, quantity
    </sql>

</mapper>
